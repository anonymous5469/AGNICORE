# WARNING: Change these secrets in production!
# Generate a strong JWT_SECRET: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here
ENABLE_DEV_TOKEN_ISSUER=false
TOKEN_ISSUER_ADMIN_SECRET=your_dev_admin_secret_here
DATABASE_URL=sqlite:./agnicore.db?mode=rwc
USER_DATABASE_URL=sqlite:./users.db?mode=rwc
PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
